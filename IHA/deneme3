GERCEK_DRONE    = True                  # True → gercek MAVSDK, False → mock
DRONE_ADRES     = "udpin://10.94.181.89:14540"            # PX4 SITL | degistir gerekirse

KP_X            = 0.002
KP_Y            = 0.002
MAX_SPEED       = 2.0                       # m/s
INIS_ALAN_ESIK  = 55_000                    # piksel² — bu alandan buyukse inis
MERKEZ_TOLERANS = 30                        # px — merkeze bu kadar yakinda inis
MAX_KAYIP       = 10                        # kac frame kayip sonra takip durur
OF_MAX_ZIPLA    = 150                       # optik akis max sapma (piksel)

YOLO_MODEL_YOL      = "yolov8n.pt"         # nano model — en hizli
YOLO_CONF           = 0.45
YOLO_IMG_BOYUT      = 320                  # kucuk giris → hiz artar
YOLO_HER_N_KARE     = 2                    # her N karede bir inference
YOLO_HEDEF_SINIFLAR = {73, 62, 63, 67}     # book, tv, laptop, cell phone (COCO)

LK_PARAMS = dict(
    winSize  = (15, 15),
    maxLevel = 2,
    criteria = (cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 20, 0.03)
)
